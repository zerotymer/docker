# .env로 복사해 default.env 값을 덮어쓴다. 빈 값도 덮어쓰므로 바꿀 키만 남긴다.

# 세션 쿠키 서명 키 (openssl rand -hex 64)
# SECRET_KEY_BASE=change-me

# 매번 --profile을 적지 않으려면 아래 줄의 주석을 푼다. 권장 값은 sqlite이다
# COMPOSE_PROFILES=sqlite

# postgres, mysql 프로필의 DB 비밀번호. 앱과 DB가 같은 값을 쓴다
# DB를 처음 만들 때만 적용된다. 이후 바꾸려면 앱 값과 DB의 ALTER를 함께 실행한다
# REDMINE_DB_PASSWORD=change-me

# mysql 프로필의 root 비밀번호 (openssl rand -hex 32)
# MYSQL_ROOT_PASSWORD=change-me

# 플러그인을 넣었을 때 시작하면서 플러그인 마이그레이션을 실행한다
# REDMINE_PLUGINS_MIGRATE=1
