# Compose 기본값. 같은 키를 .env에 적으면 .env가 우선한다.
# SQLite 프로필이 이 파일을 읽는다. PostgreSQL, MySQL 연결 값은 compose.yaml에 있다.
# Quadlet은 podman secret, pod.yaml은 Secret redmine-secret으로 세션 키를 넣는다.
TZ=Asia/Seoul

# 세션 쿠키 서명 키. 컨테이너를 다시 만들어도 로그인이 유지되게 둔다.
# 다른 호스트와 공유하기 전에 example.env를 보고 .env에서 바꾼다 (openssl rand -hex 64)
SECRET_KEY_BASE=redmine
