# FileName=adguard-home
[Unit]
Description=AdGuard Home Pod
After=network-online.target
Wants=network-online.target

[Pod]
PodName=adguard-home
ServiceName=adguard-home
# DNS
PublishPort=53:53/tcp
PublishPort=53:53/udp
# 웹 UI, DNS-over-HTTPS
PublishPort=80:80/tcp
PublishPort=443:443/tcp
PublishPort=443:443/udp
# 최초 설정 마법사
#PublishPort=3000:3000/tcp
# DNS-over-TLS, DNS-over-QUIC
PublishPort=853:853/tcp
PublishPort=853:853/udp
# DNSCrypt
PublishPort=5443:5443/tcp
PublishPort=5443:5443/udp

[Install]
WantedBy=default.target
---

# FileName=adguard-home-work
[Volume]
VolumeName=adguard-home-work
Label=app=adguard-home

---
# FileName=adguard-home-conf
[Volume]
VolumeName=adguard-home-conf
Label=app=adguard-home

---
# FileName=adguard-home-app
[Unit]
Description=AdGuard Home App

[Container]
Pod=adguard-home.pod
ContainerName=adguard-home-app
Image=docker.io/adguard/adguardhome:latest
Volume=adguard-home-work.volume:/opt/adguardhome/work
Volume=adguard-home-conf.volume:/opt/adguardhome/conf
Environment=TZ=Asia/Seoul
NoNewPrivileges=true
AutoUpdate=registry

[Service]
Restart=on-failure
RestartSec=5
