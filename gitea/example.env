# .env로 복사해 default.env 값을 덮어쓴다. 빈 값도 덮어쓰므로 바꿀 키만 남긴다.

# 사용자와 Actions runner가 접속하는 주소. localhost, 127.0.0.1은 쓰지 않는다
# gitea-runner의 GITEA_INSTANCE_URL도 같은 주소로 맞춘다
# GITEA__server__ROOT_URL=https://gitea.example.com/

# SSH 클론 URL에 표시할 호스트
# GITEA__server__SSH_DOMAIN=gitea.example.com

# 완료된 Actions run 보관 일수. 0이면 영구 보관 (기본 400)
# GITEA__actions__RUN_RETENTION_DAYS=0

# 마이그레이션, 미러가 접근할 외부 호스트를 목록으로만 허용 (기본 lax)
# 28부터 ALLOWED_DOMAINS, BLOCKED_DOMAINS 대신 ALLOWED_HOST_LIST, BLOCKED_HOST_LIST를 쓴다
# 잘못된 BLOCKED_HOST_LIST 항목(192.168.1.* 같은 IP 와일드카드, *)이 있으면 시작하지 않는다
# GITEA__migrations__EGRESS_MODE=strict
# GITEA__migrations__ALLOWED_HOST_LIST=github.com,gitlab.com

# 메일 발송. 비밀번호는 .env에만 적는다
# GITEA__mailer__ENABLED=true
# GITEA__mailer__PROTOCOL=smtps
# GITEA__mailer__SMTP_ADDR=smtp.example.com
# GITEA__mailer__SMTP_PORT=465
# GITEA__mailer__FROM=gitea@example.com
# GITEA__mailer__USER=gitea@example.com
# GITEA__mailer__PASSWD=change-me
