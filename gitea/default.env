# =============================================================================
# Gitea 기본 환경변수 (Git 커밋 대상, latest/stable 프로파일 공용)
# 서버별 값(도메인, DB 비밀번호 등)은 .env 에 작성 → .env 가 우선 적용됩니다.
#
# 버전 표기
#   [공통]    1.27 / 28 모두 적용
#   [28+]     28 이상에서만 의미 있음 (1.27 은 모르는 키로 무시)
#   [1.27]    1.27 에서만 의미 있음 (28 에서는 무시 또는 제거됨)
#
# 형식: GITEA__<섹션>__<키>=값  → 컨테이너 기동 시 /data/gitea/conf/app.ini 에 반영
#   섹션명의 "." 은 _0x2E_ 로 표기 (예: [ui.notification] → GITEA__ui_0x2E_notification__...)
#   구버전 Docker 전용 변수(DB_TYPE, ROOT_URL, DOMAIN 등 접두어 없는 형식)는 legacy → 사용 안 함
# =============================================================================


# -----------------------------------------------------------------------------
# 컨테이너 실행 사용자 [공통]
#   rootful 이미지 전용. 호스트 ./.data-* 디렉터리 소유자와 맞출 것 (id -u / id -g)
# -----------------------------------------------------------------------------
USER_UID=1000
USER_GID=1000


# -----------------------------------------------------------------------------
# [server] 접속 주소 / SSH
# -----------------------------------------------------------------------------
# [공통] 외부에서 접속하는 전체 URL (끝에 / 포함). 서버별 값은 .env 에서 덮어쓰기
#   [28+] DOMAIN 이 무시되고 ROOT_URL 기준으로 링크·클론 URL 생성 → 반드시 정확히 설정
GITEA__server__ROOT_URL=http://localhost:3000/

# [1.27] 28 에서는 무시됨 (ROOT_URL 에서 도출). 1.27 호환을 위해 유지
GITEA__server__DOMAIN=localhost

# [공통] 컨테이너 내부 HTTP 포트 (compose 의 3000:3000 과 일치)
GITEA__server__HTTP_PORT=3000

# [공통] SSH 클론 URL 에 표시될 호스트/포트 (compose 의 2222:22 → 외부 2222)
GITEA__server__SSH_DOMAIN=localhost
GITEA__server__SSH_PORT=2222
GITEA__server__SSH_LISTEN_PORT=22

# [공통] Git LFS 사용
GITEA__server__LFS_START_SERVER=true


# -----------------------------------------------------------------------------
# [database] 기본 SQLite (단일 컨테이너 구성). 운영 규모면 PostgreSQL 권장
# -----------------------------------------------------------------------------
# [공통]
GITEA__database__DB_TYPE=sqlite3
GITEA__database__PATH=/data/gitea/gitea.db

# PostgreSQL 사용 시 (DB 컨테이너 추가 후 위 2줄 대신 .env 에 작성) [공통]
# GITEA__database__DB_TYPE=postgres
# GITEA__database__HOST=postgres:5432
# GITEA__database__NAME=gitea
# GITEA__database__USER=gitea
# GITEA__database__PASSWD=          ← .env 에만 작성
# GITEA__database__SSL_MODE=disable


# -----------------------------------------------------------------------------
# [security] 설치 잠금
# -----------------------------------------------------------------------------
# [공통] false: 최초 접속 시 웹 설치 화면 표시 (SECRET_KEY 등 자동 생성 후 app.ini 저장)
#        true : 설치 화면 생략 → 관리자는 CLI 로 생성
#          docker exec -u git <컨테이너> gitea admin user create --admin \
#            --username admin --email admin@example.com --random-password
# SECRET_KEY / INTERNAL_TOKEN 은 이 파일에 쓰지 말 것 (필요 시 .env 에만)
GITEA__security__INSTALL_LOCK=false


# -----------------------------------------------------------------------------
# [service] 회원가입 / 접근 정책
# -----------------------------------------------------------------------------
# [공통] 셀프 회원가입 차단 (관리자가 계정 생성)
#   [28+] 기본값이 "차단"으로 바뀜 / 1.27 은 기본 허용 → 두 버전 동작을 맞추기 위해 명시
GITEA__service__DISABLE_REGISTRATION=true

# [공통] 로그인해야 저장소 열람 가능 (사내/개발 서버용)
GITEA__service__REQUIRE_SIGNIN_VIEW=true

# [공통] 메일 서버 미설정 상태이므로 메일 인증 비활성
GITEA__service__REGISTER_EMAIL_CONFIRM=false
GITEA__mailer__ENABLED=false

# [공통] OpenID 로그인/가입 비활성
GITEA__openid__ENABLE_OPENID_SIGNIN=false
GITEA__openid__ENABLE_OPENID_SIGNUP=false


# -----------------------------------------------------------------------------
# [actions] Gitea Actions (CI)
# -----------------------------------------------------------------------------
# [공통]
GITEA__actions__ENABLED=true

# [28+] 완료된 run(잡·로그·아티팩트 포함) 보관 일수. 기본 400일 후 자동 삭제
#       0 = 영구 보관. 디스크 여유가 있으면 0, 아니면 기본값 유지
# GITEA__actions__RUN_RETENTION_DAYS=0


# -----------------------------------------------------------------------------
# 실시간 알림
# -----------------------------------------------------------------------------
# [1.27] SSE(EventSource) 갱신 주기. 28 에서는 설정 자체가 제거됨
# GITEA__ui_0x2E_notification__EVENT_SOURCE_UPDATE_TIME=10s

# [28+] WebSocket(/-/ws) 으로 전환. 리버스 프록시에서 Upgrade/Connection 헤더 전달 필요
#       여러 Gitea 프로세스(HA) 구성일 때만 redis 지정, 단일 컨테이너는 불필요
# GITEA__websocket__PUBSUB_TYPE=redis


# -----------------------------------------------------------------------------
# 마이그레이션 / 미러 외부 접근
# -----------------------------------------------------------------------------
# [1.27] 외부 저장소 가져오기 허용 도메인. [28+] deprecated → 내부 egress 프록시 설정으로 대체
#        28 에서 잘못된 BLOCKED_HOST_LIST 항목은 기동 실패 원인 → 필요할 때만 신중히 설정
# GITEA__migrations__ALLOWED_DOMAINS=github.com,*.github.com,gitlab.com


# -----------------------------------------------------------------------------
# 기타 [공통]
# -----------------------------------------------------------------------------
GITEA__log__LEVEL=Info
GITEA__time__DEFAULT_UI_LOCATION=Asia/Seoul