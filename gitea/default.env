# Compose 기본값. 같은 키를 .env에 적으면 .env가 우선합니다.
# Quadlet Environment, pod.yaml ConfigMap gitea-default도 같은 값으로 맞춥니다.
# Gitea 28 rootless 이미지 기준
#
# GITEA__<섹션>__<키>=값은 컨테이너가 시작할 때마다 /etc/gitea/app.ini에 덮어씁니다.
# 섹션 이름의 "."은 _0x2E_로 적습니다 (예: [ui.notification] → GITEA__ui_0x2E_notification__...).
# 설치 마법사나 관리 화면에서 바꾼 값도 여기 있는 키는 재시작하면 이 값으로 돌아갑니다.

TZ=Asia/Seoul

# [server]
# 사용자가 접속하는 전체 URL (끝에 / 포함). 28부터 DOMAIN은 읽지 않고 이 값에서 도메인을 얻는다
# 링크, HTTP 클론 URL, Actions checkout 주소가 이 값을 쓴다. 실제 주소는 .env에 적는다
GITEA__server__ROOT_URL=http://localhost:3000/
GITEA__server__HTTP_PORT=3000
# SSH 클론 URL에 표시할 호스트와 포트. 호스트 2222 → 컨테이너 2222
# 이미지가 app.ini를 처음 만들 때 SSH_DOMAIN=localhost를 써 두므로 명시한다
GITEA__server__SSH_DOMAIN=localhost
# rootless 이미지는 OpenSSH가 없어 Gitea 내장 SSH 서버만 쓴다
GITEA__server__START_SSH_SERVER=true
GITEA__server__SSH_PORT=2222
GITEA__server__SSH_LISTEN_PORT=2222
GITEA__server__LFS_START_SERVER=true

# [database] 컨테이너 하나로 쓰는 SQLite
GITEA__database__DB_TYPE=sqlite3
GITEA__database__PATH=/var/lib/gitea/data/gitea.db

# [service] 28부터 셀프 회원가입은 기본 차단이다. 의도를 드러내려고 명시한다
GITEA__service__DISABLE_REGISTRATION=true
# 로그인해야 저장소를 볼 수 있다
GITEA__service__REQUIRE_SIGNIN_VIEW=true
# 메일 서버를 설정하지 않았으므로 메일 인증을 끈다
GITEA__service__REGISTER_EMAIL_CONFIRM=false
GITEA__mailer__ENABLED=false
GITEA__openid__ENABLE_OPENID_SIGNIN=false
GITEA__openid__ENABLE_OPENID_SIGNUP=false

# [actions] 완료된 run은 기본 400일 뒤 로그, 아티팩트와 함께 지워진다 (28+)
# 계속 보관하려면 .env에 GITEA__actions__RUN_RETENTION_DAYS=0
GITEA__actions__ENABLED=true

GITEA__log__LEVEL=Info
GITEA__time__DEFAULT_UI_LOCATION=Asia/Seoul

# [security] INSTALL_LOCK은 여기에 두지 않는다.
# 설치 마법사가 true로 저장한 값을 재시작마다 false로 되돌려 마법사가 다시 열린다.
