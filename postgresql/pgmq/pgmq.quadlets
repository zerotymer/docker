# FileName=pgmq
[Unit]
Description=PostgreSQL pgmq
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=pgmq
ServiceName=pgmq
Image=ghcr.io/pgmq/pg18-pgmq:v1.10.0
PublishPort=127.0.0.1:5432:5432
UserNS=keep-id:uid=999,gid=999
Volume=%h/.local/share/pgmq/data:/var/lib/postgresql:Z
# root가 /etc/tmpfiles.d/postgresql.conf로 미리 만든다 (README 참고)
Volume=/run/postgresql:/var/run/postgresql:Z
# tmpfiles.d를 쓸 수 없으면 위 줄 대신 아래 줄과 [Service]의 RuntimeDirectory 두 줄을 쓴다
# Volume=%t/pgmq:/var/run/postgresql:Z
Volume=%h/.local/share/pgmq/init:/docker-entrypoint-initdb.d:ro,Z
ShmSize=256m
Environment=POSTGRES_DB=pgmq_lab
Environment=POSTGRES_USER=postgres
Environment=TZ=Asia/Seoul
Environment=PGTZ=Asia/Seoul
# openssl rand -hex 32 | tr -d '\n' | podman secret create pgmq-password -
Secret=pgmq-password,type=env,target=POSTGRES_PASSWORD
NoNewPrivileges=true
DropCapability=NET_RAW NET_ADMIN

# systemd가 $를 확장하므로 Environment 값과 맞춰 직접 적는다
HealthCmd=pg_isready -U postgres -d pgmq_lab
HealthInterval=10s
HealthTimeout=3s
HealthRetries=5
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/pgmq/data %h/.local/share/pgmq/init
# RuntimeDirectory=pgmq
# RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=default.target
