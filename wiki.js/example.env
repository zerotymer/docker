# .env로 복사해 default.env 값을 덮어쓴다. 빈 값도 덮어쓰므로 바꿀 키만 남긴다.
# .env는 커밋하지 않는다.

# 데이터베이스 접속 정보
DB_HOST=db.example.com
# 작은따옴표(')가 들어가면 이미지의 config.yml이 깨진다. 영숫자로 만든다 (openssl rand -hex 32)
DB_PASS=change-me

# 같이 띄우는 PostgreSQL(postgres 프로필)을 쓸 때. DB_HOST는 서비스 이름으로 바꾼다
# DB_USER, DB_NAME, DB_PASS는 PostgreSQL 초기화에도 쓰인다. 첫 기동 뒤에 바꾸면 DB에 반영되지 않는다
# COMPOSE_PROFILES=postgres
# DB_HOST=postgres

# DB_TYPE은 postgres, mysql, mariadb, mssql을 쓸 수 있다. 바꾸면 DB_PORT도 맞춘다
# DB_TYPE=mysql
# DB_PORT=3306

# 데이터베이스 TLS 접속
# DB_SSL=true

# 로그 수준. error, warn, info, verbose, debug, silly
# LOG_LEVEL=info
