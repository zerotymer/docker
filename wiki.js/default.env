# Compose 기본값. 같은 키를 .env에 적으면 .env가 우선합니다.
# Quadlet Environment, pod.yaml ConfigMap wikijs도 같은 값으로 맞춥니다.
# 이 파일은 Wiki.js에만 들어갑니다. 이미지의 /wiki/config.yml이 이 값을 읽습니다.

TZ=Asia/Seoul

# 데이터베이스 접속 정보. 데이터베이스와 역할은 미리 만든다 (README 참고)
# postgres 프로필을 쓰면 .env에 DB_HOST=postgres를 적는다
# host.containers.internal은 컨테이너에서 본 호스트 주소다. 127.0.0.1에만 열린 DB에는 닿지 않는다
DB_TYPE=postgres
DB_HOST=host.containers.internal
DB_PORT=5432
DB_USER=wikijs
DB_NAME=wiki
# 예제 값이다. 실제 비밀번호는 .env에 적는다
DB_PASS=wikijs
