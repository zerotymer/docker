# Compose 기본값. 같은 키를 .env에 적으면 .env가 우선합니다.
# Quadlet Environment, pod.yaml ConfigMap wikijs-gateway도 같은 값으로 맞춥니다.

TZ=Asia/Seoul

# Wiki.js 내부 GraphQL 주소. wikijs-network의 컨테이너 이름으로 접속한다
WIKIJS_GRAPHQL_URL=http://wikijs:3000/graphql

# 아래 두 키는 비밀이라 .env에 적는다. 키가 없으면 기동하지 못하므로 빈 값을 둔다
# Wiki.js API 키. 비어 있으면 Wiki.js 호출이 권한 오류로 실패한다
WIKIJS_API_TOKEN=
# 쓰기 엔드포인트(dry-run, patch-section, upsert)의 Bearer 토큰. 비어 있으면 쓰기가 모두 거부된다
GATEWAY_ADMIN_TOKEN=
