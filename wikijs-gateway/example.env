# .env로 복사해 default.env 값을 덮어쓴다. 빈 값도 덮어쓰므로 바꿀 키만 남긴다.
# .env는 커밋하지 않는다.

# Wiki.js 관리 화면 > API 액세스에서 만든 키. 권한은 Wiki.js 쪽 그룹으로 관리한다
WIKIJS_API_TOKEN=change-me

# 쓰기 엔드포인트(dry-run, patch-section, upsert)의 Bearer 토큰 (openssl rand -hex 32)
GATEWAY_ADMIN_TOKEN=change-me

# Wiki.js가 다른 곳에 있으면 바꾼다
# WIKIJS_GRAPHQL_URL=http://wikijs:3000/graphql

# 1.0.5 이미지는 아래 두 키를 읽지 않는다. 감사 기록은 /audit에 고정이고, 쓰기 뒤 렌더링은 하지 않는다
# 이미지가 이 키를 지원하게 되면 주석을 푼다
# AUDIT_DIR=/audit
# RENDER_AFTER_WRITE=false
