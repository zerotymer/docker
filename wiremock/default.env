# Compose 기본값. 같은 키를 .env에 적으면 .env가 우선합니다.
# Quadlet Environment, pod.yaml ConfigMap wiremock-default도 같은 값으로 맞춥니다.
TZ=Asia/Seoul
JAVA_OPTS=-Xmx256m

# 이미지 엔트리포인트가 java 명령 뒤에 붙이는 WireMock CLI 옵션 (3.2.0-2+)
# 응답 템플릿 전역 적용, 요청 기록 1000건 유지, 시작 배너 생략
WIREMOCK_OPTIONS=--global-response-templating --max-request-journal=1000 --disable-banner
