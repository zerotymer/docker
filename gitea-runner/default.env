# =============================================================================
# Gitea Runner 기본 환경변수 (Git 커밋 대상, latest/stable 공용)
# 서버별 값(특히 등록 토큰)은 runner/.env 에 작성 → runner/.env 가 우선 적용
#
# 버전 표기: [공통] 4.x / 5.x 모두 적용
#
# ※ 등록 관련 변수는 "최초 등록 시"(.data-*/.runner 파일이 없을 때)에만 사용됩니다.
#   재등록하려면 해당 .data-*/.runner 삭제 후 새 토큰으로 기동
# ※ GITEA_RUNNER_CAPACITY / GITEA_RUNNER_ENV_FILE / GITEA_DEBUG 등 예전 변수는
#   제거됨(legacy) → runner/config.yaml 에서 설정
# =============================================================================

# [공통] Runner 가 접속할 Gitea 주소 (compose 네트워크 별칭 → 버전과 무관하게 동일)
GITEA_INSTANCE_URL=http://gitea:3000

# [공통] 등록 토큰 - 이 파일에 쓰지 말고 runner/.env 에만 작성
#   발급: docker exec -u git gitea-<latest|stable> gitea actions generate-runner-token
GITEA_RUNNER_REGISTRATION_TOKEN=

# [공통] Gitea 관리 화면에 표시될 이름
GITEA_RUNNER_NAME=dev-runner

# [공통] 설정 파일 경로 (compose 에서 ./runner/config.yaml 을 /config.yaml 로 마운트)
#   라벨은 config.yaml 의 runner.labels 를 사용 → GITEA_RUNNER_LABELS 는 지정하지 않음
CONFIG_FILE=/config.yaml