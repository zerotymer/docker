# Gitea ROOT_URL과 같은 주소 (localhost, 127.0.0.1 불가)
GITEA_INSTANCE_URL=https://gitea.example.com
# 사이트 관리 > Actions > Runners 에서 발급
GITEA_RUNNER_REGISTRATION_TOKEN=
GITEA_RUNNER_NAME=runner-01
GITEA_RUNNER_LABELS=ubuntu-latest:docker://docker.gitea.com/runner-images:ubuntu-latest
# rootless Podman(podman-compose)에서만 지정
# DOCKER_SOCK=/run/user/1000/podman/podman.sock
