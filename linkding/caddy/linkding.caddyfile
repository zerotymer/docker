# linkding 리버스 프록시
# 북마크 HTML 가져오기와 첨부 파일 업로드를 위해 요청 크기를 nginx와 같이 100MB로 둔다.
# HTTPS 주소로 열면 linkding에 LD_CSRF_TRUSTED_ORIGINS=https://<호스트>를 설정해야 로그인할 수 있다.
# 기본 설정이다. 배포 환경에 맞게 사이트 주소, 업스트림 주소를 수정한다.
# 인증서는 Caddy가 자동으로 발급한다. 직접 지정하려면 tls <인증서> <키>를 추가한다.

linkding.example.com {
	request_body {
		max_size 100MB
	}

	# Caddy가 컨테이너이면 같은 네트워크의 컨테이너 이름(linkding:9090)으로 바꾼다
	reverse_proxy 127.0.0.1:9090
}
