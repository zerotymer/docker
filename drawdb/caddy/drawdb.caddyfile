# drawDB 리버스 프록시
# 컨테이너 nginx가 SPA 경로를 index.html로 넘긴다. 이 파일은 그 앞단이다.
# 공유와 메일 전송은 브라우저가 VITE_BACKEND_URL로 직접 호출한다. 이 업스트림으로 가지 않는다.
# 기본 설정이다. 배포 환경에 맞게 사이트 주소, 업스트림 주소를 수정한다.
# 인증서는 Caddy가 자동으로 발급한다. 직접 지정하려면 tls <인증서> <키>를 추가한다.

drawdb.example.com {
	# Caddy가 컨테이너이면 같은 네트워크의 컨테이너 이름(drawdb:80)으로 바꾼다
	reverse_proxy 127.0.0.1:5173
}
