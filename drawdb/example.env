# .env 예시. 필요한 키만 .env에 복사해 값을 채웁니다.
# 값은 기동 시 /config.js의 자바스크립트 문자열에 그대로 들어갑니다.
# 따옴표, 역슬래시, $ 는 넣지 않습니다.

# 브라우저가 여는 공유 서버. https://github.com/drawdb-io/drawdb-server
# VITE_BACKEND_URL=https://drawdb-server.example.com

# gist API만 다른 호스트일 때. 비우면 VITE_BACKEND_URL을 쓴다
# VITE_GIST_BACKEND_URL=https://drawdb-server.example.com
