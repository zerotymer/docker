# Compose 기본값. 같은 키를 .env에 적으면 .env가 우선합니다.
# Quadlet Environment, pod.yaml ConfigMap drawdb-default도 같은 값으로 맞춥니다.
TZ=Asia/Seoul

# 브라우저가 공유와 메일 전송에 여는 drawdb-server 주소. 컨테이너는 이 주소로 접속하지 않는다.
# 비우면 앱 기본값 http://localhost:5000 을 쓴다. 에디터 자체는 이 값이 없어도 동작한다.
VITE_BACKEND_URL=
# gist만 다른 주소일 때. 비우면 VITE_BACKEND_URL을 쓴다.
VITE_GIST_BACKEND_URL=
