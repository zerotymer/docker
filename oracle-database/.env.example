# cp .env.example .env 후 값 수정
# ※ 아래 값 대부분은 "최초 DB 생성 시"에만 적용됩니다.
#   기존 볼륨(데이터파일)을 재사용하면 변경해도 DB에 반영되지 않습니다.

# ---- 공통 --------------------------------------------------------------------
# SYS / SYSTEM / PDBADMIN 공통 비밀번호 (필수, 8자 이상 대/소문자+숫자 권장)
# 미지정 시 이미지가 랜덤 생성하지만, 여기서는 :? 로 필수 처리함
ORACLE_PWD=ChangeMe_123

ORACLE_CHARACTERSET=AL32UTF8      # 한글 포함 다국어 → AL32UTF8 유지 권장
ENABLE_ARCHIVELOG=false           # 백업/복구, True Cache, GoldenGate 연동 시 true
ENABLE_FORCE_LOGGING=false        # 26ai 이상 전용 (Data Guard 등)

# ---- 이미지 태그 (재현성을 위해 운영/CI에서는 latest 대신 고정 권장) -----------
# 26ai Free 예: 23.26.x.0 / ARM64: 23.26.x.0-arm64, Lite ARM64: 23.26.x.0-lite-arm64
FREE_TAG=latest
FREE_LITE_TAG=latest-lite
EE26_TAG=latest                   # OCR 'enterprise' latest = 26ai
EE19_TAG=19.3.0.0                 # Base Release, 최신 RU는 enterprise_ru 리포지토리

# ---- 호스트 포트 (프로파일 동시 기동 대비 분리) --------------------------------
FREE_PORT=1521
FREE_LITE_PORT=1522
EE26_PORT=1523
EE19_PORT=1524

# ---- EE 전용 (19c / 26ai) -----------------------------------------------------
ORACLE_SID=ORCLCDB
ORACLE_PDB=ORCLPDB1
ORACLE_EDITION=enterprise         # enterprise | standard(SE2)
EE_MEM_LIMIT=8g                   # 컨테이너 메모리 한도 (자동 메모리 계산 기준)
AUTO_MEM_CALCULATION=true         # false면 DBCA 총 메모리 2GB 고정
INIT_SGA_SIZE=                    # MB, 지정 시 AUTO_MEM_CALCULATION 무시
INIT_PGA_SIZE=                    # MB
INIT_CPU_COUNT=
INIT_PROCESSES=
ENABLE_TCPS=false                 # true 시 2484 포트 노출 필요
