# =============================================================================
# Oracle Database 개발/테스트용 기본 환경변수 (Git 커밋 대상, 모든 서비스 공용)
# 서버별 값(특히 비밀번호)은 .env 에 작성하세요. .env 가 우선합니다.
#
# ※ 모든 값은 "최초 DB 생성 시"에만 적용됩니다.
#   기존 볼륨을 재사용하면 값을 바꿔도 DB에 반영되지 않습니다.
# ※ SID/PDB 는 Free(FREE/FREEPDB1), XE(XE/XEPDB1, 11g는 XE) 모두 고정
#   → ORACLE_SID / ORACLE_PDB 는 설정하지 마세요 (21c XE 는 값이 들어오면 오동작)
#
# 지원 여부              26ai Free   21c XE   11g XE
#   ORACLE_PWD              O          O        O (xe11.map.env 가 ORACLE_PASSWORD 로 변환)
#   ORACLE_CHARACTERSET     O          O        X (AL32UTF8 고정)
#   ENABLE_ARCHIVELOG       O          X        X
#   ENABLE_FORCE_LOGGING    O          X        X
#   (미지원 변수는 해당 컨테이너에서 무시됨)
# =============================================================================

# SYS / SYSTEM / PDBADMIN 공통 비밀번호 (11g 는 gvenzl 정책상 필수 → 비우지 말 것)
# 26ai/21c 는 비워두면 랜덤 생성 → .env 에서 반드시 지정 권장
# 기동 후 변경:
#   26ai / 21c : docker exec <컨테이너> /opt/oracle/setPassword.sh <새 비밀번호>
#   11g        : docker exec oracle-xe11 resetPassword <새 비밀번호>
ORACLE_PWD=ChangeMe_123

# 데이터베이스 문자셋 (한글 포함 다국어 → AL32UTF8 유지 권장)
ORACLE_CHARACTERSET=AL32UTF8

# 아카이브 로그 모드 (26ai Free 전용)
ENABLE_ARCHIVELOG=false

# Force logging 모드 (26ai Free 전용)
ENABLE_FORCE_LOGGING=false