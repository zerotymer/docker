# Compose 기본값. 같은 키를 .env에 적으면 .env가 우선합니다.
# Quadlet Environment, pod.yaml ConfigMap dtrack-api도 같은 값으로 맞춥니다.
# 이 파일은 API server에만 들어갑니다.

TZ=Asia/Seoul

# PostgreSQL 접속 정보. 데이터베이스와 역할은 미리 만든다 (README 참고)
# host.containers.internal은 컨테이너에서 본 호스트 주소다. 127.0.0.1에만 열린 DB에는 닿지 않는다
DT_DATASOURCE_URL=jdbc:postgresql://host.containers.internal:5432/dtrack
DT_DATASOURCE_USERNAME=dtrack
# 예제 값이다. 실제 비밀번호는 .env에 적는다
DT_DATASOURCE_PASSWORD=dtrack
