# .env로 복사해 default.env 값을 덮어쓴다. 빈 값도 덮어쓰므로 바꿀 키만 남긴다.
# .env는 커밋하지 않는다.

# PostgreSQL 접속 정보 (14 이상)
DT_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/dtrack
DT_DATASOURCE_USERNAME=dtrack
DT_DATASOURCE_PASSWORD=change-me

# 커넥션 풀 크기. 기본 30이다. DB의 max_connections 안에 들어가게 줄일 때만 지정한다
# DT_DATASOURCE_POOL_MAX_SIZE=20

# 이미지 기본 JVM 옵션(JAVA_OPTIONS) 뒤에 붙는다. 힙은 기본으로 메모리 제한의 80%다
# 바꾸면 Quadlet Environment, pod.yaml ConfigMap도 함께 수정한다
# EXTRA_JAVA_OPTIONS=-XX:MaxRAMPercentage=70.0

# 브라우저가 API에 접속하는 주소. 프론트엔드에 넘긴다. 리버스 프록시를 쓰면 공개 API 주소로 바꾼다
# API_BASE_URL=https://dependency-track-api.example.com

# 기본으로 모든 출처를 허용한다. 프록시 뒤에서 UI 주소만 허용하려면 지정한다
# DT_CORS_ALLOWED_ORIGINS=https://dependency-track.example.com
