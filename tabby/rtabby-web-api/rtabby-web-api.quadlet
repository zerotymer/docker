# FileName=rtabby-web-api
[Unit]
Description=rtabby-web-api
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=rtabby-web-api
ServiceName=rtabby
Image=ghcr.io/clem-fern/rtabby-web-api:latest
PublishPort=127.0.0.1:8080:8080
Volume=/srv/rtabby-web-api/data:/app/data:Z,U
Volume=/srv/rtabby-web-api/users.yaml:/app/users.yml:ro
Environment=DATABASEURL=sqlite:///app/data/db.sqlite

HealthCmd=curl http://localhost:8080/health
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=default.target
