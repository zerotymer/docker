# FileName=mysql
[Network]
NetworkName=mysql-network
Driver=bridge

---

# FileName=mysql
[Unit]
Description=MySQL
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=mysql
ServiceName=mysql
Image=docker.io/library/mysql:latest
PublishPort=127.0.0.1:3306:3306
# 컨테이너 mysql(999)을 호스트 사용자에 매핑한다. rootless 전용
UserNS=keep-id:uid=999,gid=999
Network=mysql.network
NetworkAlias=mysql
# 엔트리포인트가 root로 시작해 데이터 디렉터리를 mysql(999)로 chown한다. U는 붙이지 않는다
Volume=%h/.local/share/mysql:/var/lib/mysql:Z
# root가 /etc/tmpfiles.d/mysql.conf로 미리 만든다 (README 참고)
# 서버 소켓은 /run/mysqld/mysqld.sock, 호스트 클라이언트 기본 경로는 /var/lib/mysql/mysql.sock
Volume=/run/mysqld:/var/run/mysqld:Z
# tmpfiles.d를 쓸 수 없으면 위 줄 대신 아래 줄과 [Service]의 RuntimeDirectory 두 줄을 쓴다
# Volume=%t/mysql:/var/run/mysqld:Z
Environment=TZ=Asia/Seoul
Environment=MYSQL_DATABASE=app
Environment=MYSQL_USER=app
# openssl rand -hex 32 | tr -d '\n' | podman secret create mysql-root-password -
Secret=mysql-root-password,type=env,target=MYSQL_ROOT_PASSWORD
# openssl rand -hex 32 | tr -d '\n' | podman secret create mysql-password -
Secret=mysql-password,type=env,target=MYSQL_PASSWORD
NoNewPrivileges=true
DropCapability=NET_RAW NET_ADMIN

# TCP로 확인한다. 초기화 중 임시 서버는 소켓만 연다
HealthCmd=mysqladmin ping -h 127.0.0.1 --silent
HealthInterval=10s
HealthTimeout=5s
HealthRetries=12
HealthStartPeriod=60s
HealthOnFailure=kill

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/mysql
# RuntimeDirectory=mysql
# RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=default.target
