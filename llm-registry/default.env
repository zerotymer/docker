# Compose 기본값. 같은 키를 .env에 적으면 .env가 우선합니다.
# Quadlet Environment, pod.yaml ConfigMap llm-registry도 같은 값으로 맞춥니다.
# 이 파일은 PostgreSQL과 API에만 들어갑니다.

TZ=Asia/Seoul

# PostgreSQL 초기화 값. 볼륨이 비어 있을 때 한 번만 쓰인다
POSTGRES_DB=llmref
POSTGRES_USER=llmref
# 예제 값이다. 실제 비밀번호는 .env에 적는다
POSTGRES_PASSWORD=llmref

# API 접속 정보. POSTGRES_*와 같은 값으로 맞춘다. 호스트 postgres는 Compose 서비스 이름이다
DATABASE_URL=postgresql+asyncpg://llmref:llmref@postgres:5432/llmref
