# .env로 복사해 default.env 값을 덮어쓴다. 빈 값도 덮어쓰므로 바꿀 키만 남긴다.
# .env는 커밋하지 않는다.

# PostgreSQL 비밀번호. 볼륨을 처음 만들 때만 적용된다. 바꾸면 DATABASE_URL도 함께 바꾼다
# URL에 들어가므로 영문, 숫자로 만든다 (예: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://llmref:change-me@postgres:5432/llmref

# 외부 PostgreSQL을 쓰면 DATABASE_URL만 그 주소로 바꾼다
# DATABASE_URL=postgresql+asyncpg://llmref:change-me@db.example.com:5432/llmref

# JWT 서명 키. 비우면 기동할 때마다 새로 만들어 재시작하면 모든 세션이 끊긴다
# 고정하려면 지정한다 (예: openssl rand -hex 32)
# JWT_SECRET=change-me
