# .env 예시. 필요한 키만 .env에 복사해 값을 채웁니다.

# X-Forwarded-For를 믿을 프록시 주소나 대역(쉼표로 구분)
# 비워 두면 이미지 기본값(127.0.0.1, 10/8, 172.16/12, 192.168/16)을 믿는다
# TRUSTED_PROXIES=127.0.0.1

# 바인드 마운트를 쓸 때 데이터 디렉터리 소유자와 맞출 UID, GID (기본 1000)
# PUID=1000
# PGID=1000

# 프록시 없이 컨테이너가 직접 HTTPS를 열 때
# ENABLE_SSL=true
# SSL_PORT=8443
# SSL_DOMAIN=termix.example.com

# 외부 guacd를 쓸 때 (RD Gateway 등). 기본은 Termix 내장 엔진
# REMOTE_DESKTOP_ENGINE=guacd
# GUACD_HOST=guacd
