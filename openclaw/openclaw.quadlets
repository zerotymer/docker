# FileName=openclaw
[Unit]
Description=OpenClaw Pod
After=network-online.target
Wants=network-online.target

[Pod]
PodName=openclaw
PublishPort=127.0.0.1:18789:18789
PodmanArgs=--shm-size=2g

[Install]
WantedBy=default.target
---

# FileName=openclaw-vol
[Volume]
VolumeName=openclaw-vol
Label=app=openclaw

---
# FileName=openclaw-workspace
[Volume]
VolumeName=openclaw-workspace
Label=app=openclaw

---
# FileName=openclaw-app
[Unit]
Description=OpenClaw App

[Container]
Pod=openclaw.pod
ContainerName=openclaw-app
Image=ghcr.io/openclaw/openclaw:latest
Exec=node openclaw.mjs gateway --bind lan --port 18789
Volume=openclaw-vol.volume:/home/node/.openclaw
Volume=openclaw-workspace.volume:/home/node/.openclaw/workspace
Environment=NODE_ENV=production
EnvironmentFile=.env
NoNewPrivileges=true
DropCapability=NET_RAW NET_ADMIN
podmanArgs=--cpus=2 --memory=4g
AutoUpdate=registry

HealthCmd=node dist/docker-healthchk.js
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5
HealthStartPerod=20s
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartSec=5
